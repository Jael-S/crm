@startuml Diagrama_Conceptual_CRM_Educativo
!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam roundcorner 8
skinparam shadowing false
skinparam handwritten false
skinparam packageStyle rectangle

title **DIAGRAMA CONCEPTUAL DE CLASES - CRM EDUCATIVO (GRUPO 5 SC)**\nArquitectura de Dominio y Modelo de Negocio

package "Módulo 1: Seguridad y Usuarios (RBAC)" #F8F9FA {
    class Rol {
        + id_rol: int <<PK>>
        + nombre: string
        + descripcion: string
    }

    class Usuario {
        + id_usuario: int <<PK>>
        + id_rol: int <<FK>>
        + nombre_completo: string
        + correo: string
        + password_hash: string
        + activo: boolean
        + participa_round_robin: boolean
        + ultimo_acceso: datetime
        --
        + isAdmin(): boolean
        + isCoordinador(): boolean
        + isVendedor(): boolean
        + toggleActivo(): void
        + toggleRoundRobin(): void
    }

    class PasswordReset {
        + id_reset: int <<PK>>
        + id_usuario: int <<FK>>
        + token_hash: string
        + usado: boolean
        + expires_at: datetime
    }
}

package "Módulo 2: Catálogos y Tablas Maestras (Lookups)" #F8F9FA {
    class OrigenLead {
        + id_origen: int <<PK>>
        + nombre: string
    }

    class EtapaPipeline {
        + id_etapa: int <<PK>>
        + nombre: string
        + orden: int
    }

    class MotivoPerdida {
        + id_motivo: int <<PK>>
        + nombre: string
    }
}

package "Módulo 3: Gestión de Prospectos (Leads) y Asignación" #F8F9FA {
    class ImportacionCsv {
        + id_importacion: int <<PK>>
        + id_usuario: int <<FK>>
        + nombre_archivo: string
        + total_filas: int
        + filas_exitosas: int
        + filas_fallidas: int
        + created_at: datetime
    }

    class Lead {
        + id_lead: int <<PK>>
        + nombre: string
        + telefono: string
        + correo: string
        + id_origen: int <<FK>>
        + id_etapa: int <<FK>>
        + id_vendedor: int <<FK, optional>>
        + id_motivo_perdida: int <<FK, optional>>
        + comentario_perdida: string
        + id_importacion: int <<FK, optional>>
        + fecha_asignacion: datetime
        + ci: string
        + nombre_completo: string
        + fecha_nacimiento: date
        + ciudad: string
        + created_by: int <<FK>>
        + created_at: datetime
        + updated_at: datetime
        --
        + estaEnBolsaComun(): boolean
        + asignarAVendedor(idVendedor: int): void
        + marcarPerdido(idMotivo: int, comentario: string): void
        + marcarConvertido(datosMatricula: dict): void
    }

    class LeadInteres {
        + id_interes: int <<PK>>
        + id_lead: int <<FK>>
        + tipo: TipoInteres
        + id_version_externo: int <<ExtID, optional>>
        + id_modulo_externo: int <<ExtID, optional>>
        + nombre_snapshot: string
    }

    enum TipoInteres {
        PROGRAMA
        MODULO
    }

    class AsignacionLead {
        + id_asignacion: int <<PK>>
        + id_lead: int <<FK>>
        + id_vendedor_anterior: int <<FK, optional>>
        + id_vendedor_nuevo: int <<FK>>
        + asignado_por: int <<FK>>
        + tipo: TipoAsignacion
        + motivo: string
        + created_at: datetime
    }

    enum TipoAsignacion {
        MANUAL
        ROUND_ROBIN
        TRANSFERENCIA
    }

    class CoordinadorVersion {
        + id_usuario: int <<PK, FK>>
        + id_version_externo: int <<PK, ExtID>>
    }
}

package "Módulo 4: Pagos y Matrícula" #F8F9FA {
    class ComprobantePago {
        + id_comprobante: int <<PK>>
        + id_lead: int <<FK>>
        + subido_por: int <<FK>>
        + archivo_url: string
        + tipo_archivo: string
        + monto: decimal
        + estado: EstadoComprobante
        + revisado_por: int <<FK, optional>>
        + fecha_revision: datetime
        + comentario_rechazo: string
        + created_at: datetime
        --
        + aprobar(adminId: int): void
        + rechazar(adminId: int, motivo: string): void
    }

    enum EstadoComprobante {
        PENDIENTE
        APROBADO
        RECHAZADO
    }

    class EnvioMatricula {
        + id_envio: int <<PK>>
        + id_comprobante: int <<FK>>
        + id_alumno_externo: int <<ExtID, optional>>
        + estado: EstadoEnvio
        + intento: int
        + error_mensaje: string
        + created_at: datetime
    }

    enum EstadoEnvio {
        EXITOSO
        FALLIDO
        MANUAL
    }
}

package "Módulo 5: Trazabilidad y Seguimiento" #F8F9FA {
    class Bitacora {
        + id_bitacora: int <<PK>>
        + id_lead: int <<FK>>
        + id_usuario: int <<FK, optional>>
        + tipo_evento: TipoEventoBitacora
        + id_etapa_anterior: int <<FK, optional>>
        + id_etapa_nueva: int <<FK, optional>>
        + descripcion: string
        + created_at: datetime
    }

    enum TipoEventoBitacora {
        ESTADO
        ASIGNACION
        NOTA
        PAGO
        MATRICULA
        CORREO
        LLAMADA
    }

    class Recordatorio {
        + id_recordatorio: int <<PK>>
        + id_lead: int <<FK>>
        + id_usuario: int <<FK>>
        + fecha_hora: datetime
        + mensaje: string
        + completado: boolean
        + created_at: datetime
        --
        + marcarCompletado(): void
    }
}

' ========================================================
' RELACIONES Y CARDINALIDADES
' ========================================================

' Seguridad
Rol "1" <-- "0..*" Usuario : asigna rol
Usuario "1" <-- "0..*" PasswordReset : solicita

' Importaciones
Usuario "1" <-- "0..*" ImportacionCsv : sube archivo
ImportacionCsv "0..1" <-- "0..*" Lead : agrupa origen

' Lead y Lookups
OrigenLead "1" <-- "0..*" Lead : capta por canal
EtapaPipeline "1" <-- "0..*" Lead : clasifica estado actual
MotivoPerdida "0..1" <-- "0..*" Lead : justifica descarte

' Asignación y Cartera
Usuario "0..1" <-- "0..*" Lead : gestiona como vendedor
Usuario "1" <-- "0..*" AsignacionLead : realiza asignación (Admin/Coord)
Usuario "1" <-- "0..*" AsignacionLead : recibe como nuevo vendedor
Usuario "0..1" <-- "0..*" AsignacionLead : vendedor previo
Lead "1" *-- "0..*" AsignacionLead : historial de reasignación

' Vínculo con versión de programa (Coordinador)
Usuario "1" <-- "0..*" CoordinadorVersion : supervisa versión académica

' Intereses
Lead "1" *-- "1..*" LeadInteres : expresa interés en

' Pagos y Matrícula
Lead "1" *-- "0..*" ComprobantePago : adjunta
Usuario "1" <-- "0..*" ComprobantePago : sube comprobante
Usuario "0..1" <-- "0..*" ComprobantePago : aprueba/rechaza
ComprobantePago "1" *-- "0..*" EnvioMatricula : dispara registro alumno

' Bitácora y Recordatorios
Lead "1" *-- "0..*" Bitacora : registra trazabilidad
Usuario "0..1" <-- "0..*" Bitacora : autor del evento
EtapaPipeline "0..1" <-- "0..*" Bitacora : etapa anterior
EtapaPipeline "0..1" <-- "0..*" Bitacora : etapa nueva

Lead "1" *-- "0..*" Recordatorio : programa tareas
Usuario "1" <-- "0..*" Recordatorio : pertenece tarea a

@enduml
